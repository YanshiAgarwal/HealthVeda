{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "client/",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
            },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=(), microphone=(self)" },
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
          ]
        },
        {
          "source": "/ocr/(.*)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        }
      ]
    },
    "api": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "server.js",
      "installCommand": "npm ci --omit=dev",
      "bindings": [{ "type": "service", "service": "ai", "format": "url", "env": "AI_SERVICE_URL" }],
      "functions": {
        "server.js": { "maxDuration": 60 }
      }
    },
    "ai": {
      "root": "ai-service/",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 120,
          "excludeFiles": "{venv/**,.venv/**,vector_db/**,tests/**,cli/**,voice/**,scripts/**,.cache/**,data/ayurveda_dataset.csv}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
