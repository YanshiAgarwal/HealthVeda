# Copy this file to ".env" (same folder) and fill in.

# REQUIRED - shared secret; the SAME value must be in server/.env
# (generate:  cd ../server && npm run gen-secrets)
AI_SERVICE_KEY=
APP_ENV=development          # "production" hides the /docs page

# Groq (free): https://console.groq.com/keys  -> AI answers + AI report summaries
# Leave empty for offline mode (rule-based summaries, dataset answers).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Chatbot search: auto (best available) | full (needs requirements-full.txt) | lite | keyword
SEARCH_MODE=auto

# OCR: path to tesseract.exe (if not installed, RapidOCR is used when available)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=eng

# Optional: Sarvam AI voice (cli/voice_chat.py, phone calls) + Twilio phone mode
SARVAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DOMAIN=
