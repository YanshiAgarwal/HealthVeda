# Secrets for docker compose. Copy to ".env" in the project root.
# Generate the three secrets with:  cd server && npm run gen-secrets

PUBLIC_URL=https://healthveda.example.com

MONGO_USER=healthveda
MONGO_PASSWORD=change-me-to-a-long-random-password

JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
AI_SERVICE_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
