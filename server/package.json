{
  "name": "healthveda-server",
  "version": "1.0.0",
  "private": true,
  "description": "HealthVeda API server (Node.js + Express + MongoDB): auth, encrypted medical history, AI gateway",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "audit": "npm audit --omit=dev",
    "gen-secrets": "node scripts/generate-secrets.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
