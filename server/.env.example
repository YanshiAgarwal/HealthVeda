# HealthVeda server settings. Copy to ".env" and fill in.
# Create the secrets with:   npm run gen-secrets

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/healthveda

# Login tokens (min 32 random characters)
JWT_ACCESS_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Encrypts medical reports in MongoDB (32 bytes, base64). BACK THIS UP!
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
# After rotating keys, keep old ones here so old reports still open: k0:base64key
DATA_ENCRYPTION_OLD_KEYS=

# The Python AI service (must match ai-service/.env AI_SERVICE_KEY)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=

# Website address(es) allowed to call the API
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of the server (0 locally, 1 behind nginx)
TRUST_PROXY=0

LOG_LEVEL=info
